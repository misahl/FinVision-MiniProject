# FinVision Environment Configuration Example
# Copy this file to .env and adjust paths/credentials as needed.

# Local Tesseract OCR binary path (set according to your OS)
# Windows default (UB-Mannheim): C:\Program Files\Tesseract-OCR\tesseract.exe or AppData
# Linux/Cloud Run: /usr/bin/tesseract
TESSERACT_CMD=C:\Users\91938\AppData\Local\Programs\Tesseract-OCR\tesseract.exe

# Firebase Configuration
FIREBASE_PROJECT_ID=finvision-dev
GCLOUD_PROJECT=finvision-dev
FIREBASE_STORAGE_BUCKET=finvision-dev.appspot.com
FIREBASE_API_KEY=fake-api-key-for-emulator

# Firebase Emulator Switch (true for local development, false for cloud production)
FIREBASE_USE_EMULATOR=true
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:9199

# Production Service Account (leave empty when FIREBASE_USE_EMULATOR=true)
# GOOGLE_APPLICATION_CREDENTIALS=config/serviceAccountKey.json

