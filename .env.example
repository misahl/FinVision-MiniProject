# FinVision environment template. Copy to a private .env file for local development.
# Never commit .env or service-account JSON credentials.

# Local development only: set true when Firebase emulators are running.
FIREBASE_USE_EMULATOR=true
FIREBASE_PROJECT_ID=YOUR_FIREBASE_PROJECT_ID
GCLOUD_PROJECT=YOUR_FIREBASE_PROJECT_ID
FIREBASE_STORAGE_BUCKET=YOUR_EXACT_STORAGE_BUCKET_NAME
FIREBASE_API_KEY=YOUR_FIREBASE_WEB_API_KEY

FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:9199

# Production only: use Streamlit Secrets or a secure secret manager.
# Never commit a service account key.
# GOOGLE_APPLICATION_CREDENTIALS=/secure/path/to/service-account.json
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account", ...}

# Local Tesseract path (adjust to your machine; cloud deployment needs Linux Tesseract).
# TESSERACT_CMD=C:\\Program Files\\Tesseract-OCR\\tesseract.exe
